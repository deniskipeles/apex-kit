# -------------------------------------------------------------
# Stage 1: Build the Admin UI Dashboard
# -------------------------------------------------------------
FROM node:18-bullseye-slim AS frontend
WORKDIR /build

COPY admin-ui/package*.json ./admin-ui/
RUN cd admin-ui && npm install

COPY admin-ui/ ./admin-ui/
RUN cd admin-ui && npm run build

# -------------------------------------------------------------
# Stage 2: Cross-compile Rust for macOS with Zig & Apple SDK
# -------------------------------------------------------------
FROM rust:1-bookworm AS builder
WORKDIR /workspace

# 1. Install build tools, Clang/LLVM (for bindgen), Python, and utilities
RUN apt-get update && apt-get install -y \
    curl \
    xz-utils \
    cmake \
    pkg-config \
    protobuf-compiler \
    clang \
    libclang-dev \
    llvm-dev \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Set LIBCLANG_PATH so bindgen finds libclang.so automatically
ENV LIBCLANG_PATH=/usr/lib/llvm-16/lib

# 2. Install pinned ziglang and cargo-zigbuild
RUN pip3 install --no-cache-dir --break-system-packages \
    "ziglang==0.13.0" \
    "cargo-zigbuild==0.23.1"

# 3. Download and configure the macOS SDK stubs
RUN mkdir -p /opt && \
    curl -sSL https://github.com/joseluisq/macosx-sdks/releases/download/12.3/MacOSX12.3.sdk.tar.xz | tar -xJ -C /opt

ENV SDKROOT=/opt/MacOSX12.3.sdk

# 4. Copy built frontend assets
RUN mkdir -p static/dashboard
COPY --from=frontend /build/admin-ui/dist/ ./static/dashboard/

# 5. Copy workspace source code
COPY . .

# Select target: aarch64-apple-darwin (Apple Silicon) or x86_64-apple-darwin (Intel)
ARG TARGET=aarch64-apple-darwin
ENV TARGET=${TARGET}

# 6. Add target and build release binary without ONNX
RUN rustup target add ${TARGET} && \
    cargo zigbuild --target ${TARGET} --release -p apexkit-cli --no-default-features

# -------------------------------------------------------------
# Stage 3: Output artifact
# -------------------------------------------------------------
FROM scratch AS export
COPY --from=builder /workspace/target/*/release/apexkit-cli /